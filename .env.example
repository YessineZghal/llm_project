# Copy to .env and fill in. Never commit the real .env file.

# --- App LLM access (used by our Python code, e.g. via openai/anthropic SDKs) ---
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# --- App model/index config (optional; defaults shown are used if unset) ---
OPENAI_CHAT_MODEL=gpt-4o-mini
OPENAI_JUDGE_MODEL=gpt-4o-mini
EMBEDDING_MODEL_NAME=sentence-transformers/all-MiniLM-L6-v2
RERANK_MODEL_NAME=cross-encoder/ms-marco-MiniLM-L-6-v2

# --- Elasticsearch (docker-compose.yml service `elasticsearch`) ---
# When running the app outside Docker (e.g. `uv run streamlit run ...`), leave
# this as localhost; inside docker-compose the `app` service overrides it to
# http://elasticsearch:9200.
ELASTIC_URL=http://localhost:9200
ELASTIC_INDEX_NAME=arxiv-papers

# --- Kestra (docker-compose.yml) ---
# Only needed if you use Kestra's AI Copilot / web-research flows from the
# course's 03-orchestration module. Safe to leave blank otherwise.
SECRET_OPENAI_API_KEY=
SECRET_GEMINI_API_KEY=
SECRET_TAVILY_API_KEY=
GEMINI_API_KEY=

# --- App database (conversation logging + feedback/monitoring, via psycopg) ---
# Read by src/llm_project/config.py and by the docker-compose.yml `app_postgres`
# service. When running outside Docker, APP_POSTGRES_HOST/PORT default to
# localhost:5433 (the host port docker-compose maps to app_postgres:5432).
APP_POSTGRES_HOST=localhost
APP_POSTGRES_PORT=5433
APP_POSTGRES_DB=llm_project
APP_POSTGRES_USER=llm_project
APP_POSTGRES_PASSWORD=llm_project
