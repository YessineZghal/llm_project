# Copy to .env and fill in. Never commit the real .env file.

# --- App LLM access (used by our Python code, e.g. via openai/anthropic SDKs) ---
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# --- Kestra (docker-compose.yml) ---
# Only needed if you use Kestra's AI Copilot / web-research flows from the
# course's 03-orchestration module. Safe to leave blank otherwise.
SECRET_OPENAI_API_KEY=
SECRET_GEMINI_API_KEY=
SECRET_TAVILY_API_KEY=
GEMINI_API_KEY=

# --- App database (feedback/monitoring, via psycopg) ---
POSTGRES_DB=
POSTGRES_USER=
POSTGRES_PASSWORD=
